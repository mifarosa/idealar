# Copy to .env and fill in. .env is git-ignored.

# Generate with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
DEBUG=false

# Comma-separated hostnames this server answers to (add your Tailscale MagicDNS name).
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins with scheme, required for POST over HTTPS (e.g. login form).
CSRF_TRUSTED_ORIGINS=

# Set to true when TLS is terminated by a proxy (tailscale serve) in front of Django.
BEHIND_HTTPS_PROXY=false

# SQLite now; switch to Postgres later, e.g. postgres://user:pass@localhost:5432/idealar
DATABASE_URL=sqlite:///db.sqlite3

# Daily backup script: where to write and how many days to keep.
BACKUP_DIR=backups
BACKUP_KEEP_DAYS=30
