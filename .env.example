# Copy to .env and fill in. .env is git-ignored.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
# (avoid `$` in the key: Docker Compose treats it as variable interpolation)
SECRET_KEY=change-me
DEBUG=false

# Comma-separated hostnames this server answers to (add your Tailscale MagicDNS name).
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins with scheme, required for POST over HTTPS (e.g. login form).
CSRF_TRUSTED_ORIGINS=

# Set to true when TLS is terminated by a proxy (tailscale serve) in front of Django.
BEHIND_HTTPS_PROXY=false

# Sign in with Google: create an OAuth client (type "Web application") at
# https://console.cloud.google.com/apis/credentials and add this redirect URI:
#   https://YOUR-DOMAIN/accounts/google/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# true = any verified Google account may create a user. Keep false until every user brings their own AI key.
GOOGLE_SIGNUP=false

# SQLite now; switch to Postgres later, e.g. postgres://user:pass@localhost:5432/idealar
DATABASE_URL=sqlite:///db.sqlite3

# Daily backup script: where to write and how many days to keep.
BACKUP_DIR=backups
BACKUP_KEEP_DAYS=30

# Secret that seals users' AI API keys in the database (defaults to SECRET_KEY). Changing it makes saved keys unreadable.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(40))"
KEYS_ENCRYPTION_KEY=

# --- AI ---
# Users add their own models and keys in the app. The settings below are only used by the staff
# "import from .env" button and by `manage.py ai_models`.
# Order = priority: first is primary, the rest are fallbacks. Available: groq, gemini, openrouter, ollama.
AI_PROVIDERS=groq,ollama
# Free key: https://console.groq.com/keys  (leave empty to skip Groq and use Ollama only)
GROQ_API_KEY=
# Groq retires models over time; list what your key can use with: docker compose exec web python manage.py ai_models
GROQ_MODEL=openai/gpt-oss-120b
# Local fallback (Ollama running on this computer). Compose points this at the host automatically.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
# Optional third provider (add "openrouter" to AI_PROVIDERS to use it).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
# Google AI Studio (Gemini). Add "gemini" to AI_PROVIDERS, e.g. AI_PROVIDERS=groq,gemini,ollama
# Key: https://aistudio.google.com/apikey . GEMINI_MODEL is optional (default: gemini-flash-lite-latest);
# list valid names with `manage.py ai_models`.
GEMINI_API_KEY=
# GEMINI_MODEL=

# Anthropic Claude (paid, no free tier). Add "anthropic" to AI_PROVIDERS, e.g. AI_PROVIDERS=groq,anthropic,ollama
# Key: https://console.anthropic.com/settings/keys . ANTHROPIC_MODEL is optional (default: claude-opus-5-5);
# a cheaper model such as claude-haiku-5-5 is enough for notes. List valid names with `manage.py ai_models`.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# --- GitHub project review ---
# Optional. Public repos work without it (60 requests/hour limit). For private repos or higher limits create a
# fine-grained token with read-only "Contents" and "Metadata" access: https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=
# Optional: pre-fills the import page (Projeler -> GitHub'dan içe aktar).
GITHUB_USERNAME=
# Max characters of repository text sent to the AI per review.
# REPO_ANALYSIS_MAX_CHARS=24000
