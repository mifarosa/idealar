msgstr[1] "All your notes were read: {n} suggestions are ready."

#: ideas/ai_views.py:42 templates/ideas/_idea_detail.html:66
msgid "Tüm notların okundu; şimdilik önerecek bir şey bulamadım."
msgstr "All your notes were read; I have nothing to suggest for now."

#: ideas/ai_views.py:44
msgid "AI şu an yanıt veremedi. Biraz sonra tekrar dene."
msgstr "The AI could not answer right now. Try again in a moment."

#: ideas/ai_views.py:55 templates/ideas/_idea_detail.html:63
msgid "Uygulandı."
msgstr "Applied."

#: ideas/ai_views.py:55
msgid "Tamam, öneri gizlendi."
msgstr "OK, the suggestion is hidden."

#: ideas/ai_views.py:57 ideas/ai_views.py:90
msgid "Bu kayıt artık yok (silinmiş olabilir)."
msgstr "This item no longer exists (it may have been deleted)."

#: ideas/ai_views.py:74
msgid "AI şu an yanıt veremedi; yalnızca kelime benzerliğine baktım."
msgstr "The AI could not answer right now; I only looked at word similarity."

#: ideas/ai_views.py:76
#, python-brace-format
msgid "Benzerlik kontrolü tamamlandı: {n} benzer kayıt bulundu."
msgid_plural "Benzerlik kontrolü tamamlandı: {n} benzer kayıt bulundu."
msgstr[0] "Similarity check finished: {n} similar item found."
msgstr[1] "Similarity check finished: {n} similar items found."

#: ideas/ai_views.py:78
msgid "Benzerlik kontrolü tamamlandı: benzer kayıt bulunmadı."
msgstr "Similarity check finished: no similar items found."

#: ideas/ai_views.py:88 ideas/chat_views.py:182
