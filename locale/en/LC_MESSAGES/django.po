msgstr "Saved key: …{saved}. Leave empty if you do not want to change it."

#: ideas/ai_settings_forms.py:44
msgid "Anahtar şifrelenip saklanır ve bir daha gösterilmez."
msgstr "The key is stored encrypted and is never shown again."

#: ideas/ai_settings_forms.py:55
msgid "Anahtar boşluk içeremez; kopyalarken fazladan bir şey gelmiş olabilir."
msgstr ""
