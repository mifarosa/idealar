msgstr "off"

#: ideas/ai_registry.py:37
msgid "bu tür yalnızca yönetici hesabında çalışır"
msgstr "this kind only works on an administrator account"

#: ideas/ai_registry.py:39
msgid "model seçilmedi (\"Modeller\" tuşuna bas)"
msgstr "no model chosen (press the \"Models\" button)"

#: ideas/ai_registry.py:41
msgid "anahtar kayıtlı değil"
msgstr "no key saved"

#: ideas/ai_registry.py:43
msgid ""
"kayıtlı anahtar okunamıyor (şifreleme anahtarı değişmiş); modeli düzenleyip "
"anahtarı yeniden gir"
msgstr ""
"the saved key cannot be read (the encryption key has changed); edit the "
"model and enter the key again"

#: ideas/ai_registry.py:63
msgid "Diğer (OpenAI uyumlu)"
msgstr "Other (OpenAI compatible)"

#: ideas/ai_registry.py:90
